/* ================================================
   COS 文件管理器 - 页面样式
   风格：科技蓝 · 玻璃拟态 · 流光动效
   ================================================ */

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
}

/* ========== 头部导航栏 ========== */
.header {
  background: linear-gradient(135deg, #0052d9 0%, #4364f7 50%, #6fb1fc 100%);
  color: #ffffff;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
}

.header-left {
  flex: 1;
  min-width: 280rpx;
}

/* Logo 区域 */
.logo-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo-icon {
  font-size: 48rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title-area {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 22rpx;
  opacity: 0.85;
}

/* 右侧操作区 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.action-btn-group {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

/* 通用操作按钮（配置 / 刷新） */
.action-btn-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 12rpx;
  transition: all 0.25s ease;
  backdrop-filter: blur(8rpx);
}

.action-btn-item:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.25);
}

/* 刷新按钮高亮变体 */
.action-btn-primary {
  background: rgba(255, 255, 255, 0.95);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.action-btn-primary:active {
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.action-btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
}

.action-btn-primary .action-btn-text {
  color: #0052d9;
}

/* 刷新图标旋转动画 */
.refresh-icon {
  font-size: 32rpx;
  color: #0052d9;
  line-height: 1;
  display: inline-block;
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ================================================
   位置上报按钮 — 基于 TDesign t-button 科技玻璃态设计
   ================================================
   
   使用 t-button + 自定义 class 覆写，保留科技玻璃风格：
   - 默认态：白色半透明玻璃底 + 冷光细描边；
   - 上报中：边框转为青蓝高亮，box-shadow 呼吸脉动，
     文字后方追加紧凑闪烁圆点（圆点 + 脉冲环同周期同步）。
*/

.track-btn {
  background: rgba(255, 255, 255, 0.15) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.3) !important;
  border-radius: 12rpx !important;
  color: #ffffff !important;
  font-weight: 500 !important;
  font-size: 26rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.2);
  transition: all 0.25s ease !important;
  padding: 0 24rpx !important;
  height: 75rpx !important;
}

/* t-button 内部文字容器 */
.track-btn .t-button__text {
  color: #ffffff !important;
  font-size: 26rpx !important;
  font-weight: 500 !important;
}

/* t-button 内部图标颜色 */
.track-btn .t-icon {
  color: #ffffff !important;
}

.track-btn:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.22) !important;
}

/* ---------- 上报中激活态：青蓝高亮边框 + 静态光晕（不抖动） ---------- */
.track-btn--active {
  background: rgba(0, 200, 255, 0.18) !important;
  border-color: rgba(0, 220, 255, 0.65) !important;
  box-shadow:
    0 0 16rpx rgba(0, 210, 255, 0.35),
    0 4rpx 16rpx rgba(0, 130, 255, 0.25);
}

.track-btn--active:active {
  background: rgba(0, 200, 255, 0.28) !important;
}

/* ========== 闪烁圆点指示器（紧凑版，同周期 1.8s） ==========

   结构：.tracking-dot-wrap 为固定尺寸正方形容器，
   圆点 (.tracking-dot) 居中叠在脉冲环 (.tracking-dot-ring) 上方；
   两者使用相同动画周期 1.8s，视觉节拍一致。
*/
.tracking-dot-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
  vertical-align: middle;
}

/* 脉冲扩散环：从圆点尺寸向外扩散消隐 */
.tracking-dot-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 36rpx;
  margin: -18rpx 0 0 -18rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(0, 229, 255, 0.9);
  animation: dot-ring-pulse 1.8s ease-out infinite;
}

/* 圆点本体：闪烁高亮 */
.tracking-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #00e5ff;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  animation: dot-blink 1.8s ease-in-out infinite;
}

/* 圆点闪烁：亮 → 暗，周期 1.8s */
@keyframes dot-blink {
  0%, 100% {
    opacity: 1;
    box-shadow:
      0 0 12rpx rgba(0, 229, 255, 1),
      0 0 24rpx rgba(0, 210, 255, 0.85),
      0 0 40rpx rgba(0, 180, 255, 0.6);
  }
  50% {
    opacity: 0.2;
    box-shadow:
      0 0 4rpx rgba(0, 229, 255, 0.4),
      0 0 8rpx rgba(0, 210, 255, 0.15);
  }
}

/* 脉冲环：从原点扩散至 2.5× 后消隐，周期 1.8s */
@keyframes dot-ring-pulse {
  0%   { transform: scale(1);   opacity: 0.9; }
  100% { transform: scale(2.5); opacity: 0; }
}

/* ========== 上传区域 ========== */
.upload-section {
  margin: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* 上传按钮包裹层：渐变底色 + 光影 */
.upload-btn-wrap {
  width: 100%;
  max-width: 400rpx;
  background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 114, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.upload-btn-wrap::after {
  border: none;
}

.upload-btn-wrap:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 114, 255, 0.3);
  background: linear-gradient(135deg, #00a8e8 0%, #005ed9 100%);
}

/* 内部 TDesign 按钮透传样式 */
.upload-inner-btn {
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  letter-spacing: 2rpx;
  background: transparent !important;
  border: none !important;
}

.upload-tip {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

/* 上传队列列表 */
.upload-queue {
  width: 100%;
  margin-top: 16rpx;
}

.upload-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.upload-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.upload-name {
  font-size: 26rpx;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-status {
  font-size: 24rpx;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.upload-status.uploading {
  color: var(--primary-color);
  background: rgba(0, 82, 217, 0.1);
}

.upload-status.success {
  color: var(--success-color);
  background: rgba(0, 133, 66, 0.1);
}

.upload-status.fail {
  color: var(--danger-color);
  background: rgba(213, 73, 65, 0.1);
}

/* ========== 文件列表区域 ========== */
.file-list-section {
  margin: 0 24rpx 24rpx;
  padding: 0;
  overflow: hidden;
}

/* 列表头部 */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
  flex-wrap: wrap;
  gap: 16rpx;
}

.list-title-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.file-count {
  font-size: 22rpx;
  color: var(--primary-color);
  background: rgba(0, 82, 217, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.list-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-badge {
  background: linear-gradient(135deg, #0052d9 0%, #4364f7 100%);
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== 表格容器 ========== */
.table-wrapper {
  padding: 0;
}

/* 固定表头，防止随内容滚动 */
.table-header-fixed {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: var(--bg-color);
}

/* 列表体可滚动区域 */
.table-body-scroll {
  max-height: 1100rpx;
  overflow-y: auto;
}

/* 选中行高亮 */
.selected-row {
  background-color: rgba(0, 82, 217, 0.08) !important;
}

/* 行内操作按钮组 */
.action-btns {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: transparent;
  transition: all 0.2s;
}

.action-btn:active {
  background-color: rgba(0, 0, 0, 0.05);
  transform: scale(0.92);
}

.action-btn-danger:active {
  background-color: rgba(213, 73, 65, 0.1);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon-area {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e6f0ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-placeholder);
  margin-bottom: 32rpx;
}

/* ========== 加载中状态 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-placeholder);
  margin-top: 20rpx;
}

/* ========== 列表底部提示 ========== */
.list-footer {
  padding: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: var(--card-bg);
  border-top: 1rpx solid var(--border-color);
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* ========== 表格行列基础样式 ========== */
.tr {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--border-color);
}

.tr.header-row {
  background-color: var(--bg-color);
  font-weight: 500;
  color: var(--text-secondary);
}

.tr:not(.header-row) {
  background-color: var(--card-bg);
}

.tr:not(.header-row):active {
  background-color: rgba(0, 82, 217, 0.08);
}

.th, .td {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
}

/* 复选框列 */
.th-checkbox, .td-checkbox {
  display: flex;
  width: 80rpx;
  min-width: 80rpx;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.th-checkbox:active, .td-checkbox:active {
  opacity: 0.7;
  transform: scale(0.9);
}

/* 文件名列 */
.th-name, .td-name {
  flex: 1;
  padding: 20rpx 16rpx;
  overflow: hidden;
}

/* 表头文件名列：标签 + 搜索框同行 */
.th-name {
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 12rpx;
}

.th-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

/* 内嵌搜索框 */
.inline-search {
  display: flex;
  align-items: center;
  background-color: var(--card-bg);
  border-radius: 20rpx;
  padding: 12rpx 16rpx;
  gap: 8rpx;
  border: 2rpx solid var(--border-color);
  transition: border-color 0.2s;
  flex: 1;
  min-width: 0;
}

.inline-search:focus-within {
  border-color: var(--primary-color);
}

.inline-search-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  height: 40rpx;
  line-height: 40rpx;
}

.inline-search-input::placeholder {
  color: var(--text-placeholder);
}

.clear-btn {
  padding: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 操作列 */
.th-action, .td-action {
  width: 200rpx;
  min-width: 200rpx;
  justify-content: center;
  flex-shrink: 0;
}

/* 文件名单元格 */
.td-name {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.td-name .file-name {
  flex: 1;
  color: var(--text-primary);
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
}
